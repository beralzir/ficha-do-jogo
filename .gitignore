# Sistema operacional
.DS_Store
**/.DS_Store

# Cloudflare / wrangler — estado local
.wrangler/

# Node — a wrangler-action instala wrangler no workspace durante o deploy no CI (não versionar)
node_modules/
package.json
package-lock.json

# Python
__pycache__/
*.pyc
*.pyo

# Claude Code — config local da máquina (permissões, launcher do wrangler dev com caminho local)
.claude/settings.local.json
.claude/launch.json

# Segredos — NUNCA versionar. Tokens vão em GitHub Secrets (Fase 3 da automação).
.env
.env.*
.dev.vars
*.token
*.secret
docs/Football-data.md
docs/*api*key*
docs/*token*

# Research pesado — mantido local, não precisa no CI (PDF de 16MB)
docs/*.pdf

# Backups efêmeros de estado (rollback local; no CI o rollback é git)
data/live/backups/

# Cache de respostas de API (gravações locais p/ teste offline)
.api_cache/

# Candidato transiente da ingestão (staging antes de promover)
data/live/state.json.candidate
